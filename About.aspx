<%@ Page Title="About Us"
    Language="C#"
    MasterPageFile="~/Site.Master"
    AutoEventWireup="true"
    CodeBehind="About.aspx.cs"
    Inherits="FoodDonationManagement.About" %>

<asp:Content ID="Content1"
    ContentPlaceHolderID="head"
    runat="server">
</asp:Content>

<asp:Content ID="Content2"
    ContentPlaceHolderID="ContentPlaceHolder1"
    runat="server">

    <section class="about-section">

        <div class="about-container">

            <div class="about-header">
                <h1>About Food Donation Management System 🍱</h1>

                <p>
                    Connecting surplus food with people in need
                    through a simple and efficient platform.
                </p>
            </div>


            <div class="about-content">

                <div class="about-card">

                    <h2>❤️ Our Mission</h2>

                    <p>
                        Our mission is to reduce food waste and help
                        people who are in need by connecting food donors,
                        NGOs and volunteers through one platform.
                    </p>

                </div>


                <div class="about-card">

                    <h2>🌱 Reduce Food Waste</h2>

                    <p>
                        Large amounts of edible food are wasted every day.
                        Our system helps donors share their surplus food
                        instead of throwing it away.
                    </p>

                </div>


                <div class="about-card">

                    <h2>🤝 Connect Donors & NGOs</h2>

                    <p>
                        Donors can submit available food donations and
                        NGOs can view and accept suitable donations
                        for people who need them.
                    </p>

                </div>


                <div class="about-card">

                    <h2>🚚 Volunteer Delivery</h2>

                    <p>
                        Volunteers help collect accepted food donations
                        from donors and deliver them to the required
                        destination.
                    </p>

                </div>


                <div class="about-card">

                    <h2>👥 How It Works</h2>

                    <p>
                        Donor submits food → NGO accepts donation →
                        Volunteer accepts delivery → Food is picked up
                        and delivered to people in need.
                    </p>

                </div>


                <div class="about-card">

                    <h2>🌍 Our Vision</h2>

                    <p>
                        We aim to create a community where good food is
                        shared with people in need instead of being wasted.
                        Together, we can reduce food waste and spread hope.
                    </p>

                </div>

            </div>


            <div class="about-bottom">

                <h2>Share Food, Spread Hope ❤️</h2>

                <p>
                    Every donation can make a difference.
                    Join us in building a better and more caring community.
                </p>

            </div>

        </div>

    </section>

</asp:Content>