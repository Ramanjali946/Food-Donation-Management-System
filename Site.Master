<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="FoodDonationManagement.site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>Food Donation Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" type="text/css"
        href="<%= ResolveUrl("~/style.css") %>" />
    <script src="<%= ResolveUrl("~/script.js") %>"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>

    <form id="form1" runat="server">

        <!-- NAVBAR -->
        <nav class="navbar">

            <div class="nav-container">

                <a href="Home.aspx" class="logo"><i class="bi bi-basket2-fill"></i> Food<span>Donation</span>
                </a>

                <div class="nav-links">

                    <a href="Home.aspx" class="nav-link">Home
                    </a>

                    <a href="About.aspx" class="nav-link">About
                    </a>

                    <a href="DonateFood.aspx" class="nav-link">Donate Food
                    </a>

                    <a href="NGOs.aspx" class="nav-link">NGOs
                    </a>

                    <a href="Volunteer.aspx" class="nav-link">Volunteers
                    </a>

                    <asp:PlaceHolder ID="phGuest" runat="server">
                        <a href="Login.aspx" class="nav-login">Login</a>
                        <a href="Register.aspx" class="nav-register">Register</a>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phUser" runat="server">
                        <a id="lnkDashboard" runat="server" class="nav-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
                        <span class="nav-user"><i class="bi bi-person-circle"></i> <asp:Literal ID="litUser" runat="server" /></span>
                        <asp:LinkButton ID="btnLogout" runat="server" CssClass="nav-logout"
                            OnClick="btnLogout_Click">Logout</asp:LinkButton>
                    </asp:PlaceHolder>

                </div>

            </div>

        </nav>


        <!-- PAGE CONTENT -->

        <asp:ContentPlaceHolder ID="ContentPlaceHolder1"
            runat="server">
        </asp:ContentPlaceHolder>


        <!-- FOOTER -->

        <footer class="footer">

            <h3>Food Donation Management System</h3>

            <p>
                Share Food, Spread Hope ❤️
            </p>

            <p>
                Together we can reduce food waste and help people in need.
            </p>

            <p>
                © 2026 Food Donation Management System
            </p>

        </footer>

    </form>

</body>
</html>
